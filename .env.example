# ---- Server ----
APP_ENV=development
HTTP_ADDR=:8080
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080
SESSION_COOKIE_NAME=tks_session
SESSION_TTL_HOURS=720

# ---- Postgres ----
DATABASE_URL=postgres://tks:tks@localhost:5432/tks?sslmode=disable

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- MinIO ----
MINIO_ENDPOINT=localhost:9100
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=tks
MINIO_USE_SSL=false
# Endpoint the *browser* uses for presigned URLs (may differ from internal endpoint)
MINIO_PUBLIC_ENDPOINT=localhost:9100

# ---- Auth ----
ALLOW_DEV_LOGIN=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/callback

# ---- AI (OpenAI-compatible) ----
# Leave AI_API_KEY empty to run the deterministic mock provider (full flow works offline).
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=90
AI_MAX_ATTEMPTS=3

# ---- Images ----
# Leave UNSPLASH_ACCESS_KEY empty to use the offline picsum stub provider.
IMAGE_PROVIDER=unsplash
UNSPLASH_ACCESS_KEY=

# ---- Research ----
# Live web search for carousel fact-finding. Leave empty to skip it: the AI is
# then told to rely on established knowledge and to return NO sources rather
# than inventing URLs. Currently expects a Tavily key (https://tavily.com).
SEARCH_API_KEY=

# ---- Worker ----
WORKER_CONCURRENCY=2
